NEXT_PUBLIC_API_BASE_URL=https://api.sansekai.my.id/api
NEXT_PUBLIC_CRYPTO_SECRET=Sansekai-SekaiDrama

# 회원가입/로그인/광고 관리 기능에 필요합니다. 표준 Postgres 연결 문자열이면 됩니다
# (로컬 Postgres, Docker, Vercel Postgres, Neon 등 모두 가능).
# 예시(로컬): postgres://postgres:비밀번호@localhost:5433/postgres
# Vercel Postgres를 연결한 경우 Vercel이 자동으로 주입해주므로, 로컬 개발 시에만 채우면 됩니다.
POSTGRES_URL=

# 세션(JWT) 서명용 비밀키. 아무 임의의 긴 문자열로 설정하세요. (예: openssl rand -base64 32)
JWT_SECRET=

# 최초 관리자 계정을 만들 때만 사용합니다 (scripts/seed-admin.ts, `npm run db:seed`).
# 값을 채운 뒤 db:seed를 한 번 실행하고, 실행 후에는 값을 비워두거나 지우는 것을 권장합니다.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
